{
  "name": "dustline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:track": "node tools/verify-track-format.mjs",
    "verify:sdf": "node tools/verify-sdf.mjs",
    "verify:templates": "node tools/verify-templates.mjs",
    "verify:separation": "node tools/verify-separation.mjs",
    "verify:worlds": "node tools/verify-worlds.mjs",
    "verify:generated": "node tools/verify-generated.mjs",
    "make:proving-ground": "node tools/make-proving-ground.mjs",
    "make:harbour": "node tools/make-harbour.mjs",
    "make:sets": "node tools/make-set-sheets.mjs",
    "make:shots": "node tools/make-shots.mjs",
    "smoke:editor": "node tools/editor-smoke.mjs",
    "smoke:components": "node tools/components-smoke.mjs",
    "verify:deploy": "node tools/verify-deploy.mjs",
    "gate": "npm run typecheck && npm run verify:separation && npm run verify:templates && npm run verify:track && npm run verify:sdf && npm run verify:generated && npm run verify:coverage && npm run verify:regressions",
    "gate:full": "npm run build && npm run gate && npm run verify:worlds && npm run verify:physics && npm run verify:architecture && npm run verify:clearance && npm run verify:solidity && npm run verify:terrain && npm run verify:boot && npm run verify:mobile && npm run smoke:components && npm run smoke:editor && npm run verify:deploy",
    "verify:physics": "node tools/verify-physics.mjs",
    "verify:architecture": "node tools/verify-architecture.mjs",
    "verify:clearance": "node tools/verify-clearance.mjs",
    "verify:solidity": "node tools/verify-solidity.mjs",
    "verify:terrain": "node tools/verify-terrain-integrity.mjs",
    "verify:coverage": "node tools/verify-coverage.mjs",
    "verify:boot": "node tools/verify-boot-state.mjs",
    "verify:regressions": "node tools/verify-regression-memory.mjs",
    "verify:mobile": "node tools/verify-mobile.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "howler": "^2.2.4",
    "three": "^0.160.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
